<?xml version="1.0" encoding="utf-8"?>
<!-- Native Windows Installer for the invite-only ArtCraft preparation track.
     The existing EXE self-installer stays a separate distribution format.
     MSI and standalone installs are intentionally blocked from overlapping. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="DesktopCraft"
           Manufacturer="DesktopCraft contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="b912bef5-ce48-4e23-89dc-7b2d8377912e"
           Scope="perUser"
           InstallerVersion="500"
           Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DesktopCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="DesktopCraftIcon" SourceFile="assets/desktopcraft.ico" />
    <Property Id="ARPPRODUCTICON" Value="DesktopCraftIcon" />

    <!-- The original .exe installer has a custom Apps & Features registry
         entry rather than a Windows Installer product code. Block mixing the
         two installer ownership models on the same account. -->
    <Property Id="DESKTOPCRAFT_STANDALONE_INSTALLED">
      <RegistrySearch Id="FindStandaloneInstaller"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\DesktopCraft"
                      Name="DisplayVersion" Type="raw" />
    </Property>
    <Launch Condition="NOT DESKTOPCRAFT_STANDALONE_INSTALLED"
            Message="DesktopCraft was installed using its EXE installer. Uninstall that copy from Windows Settings first, then run this MSI. Your workspace data is preserved." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DesktopCraft">
          <Component Id="DesktopCraftProgram" Guid="a0df831d-cc42-4cca-935f-b0d4df1a6afb">
            <File Id="DesktopCraftExe" Source="$(var.BuildExe)" Name="DesktopCraft.exe" />
            <!-- HKCU key path is required for the per-user MSI component. -->
            <RegistryValue Root="HKCU" Key="Software\DesktopCraft\MSI"
                           Name="Program" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="DesktopCraftShellMenus" Guid="5a27e337-c728-4991-898a-2f462c5546a6">
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftNewGroup" Name="MUIVerb" Type="string" Value="New group here" KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftNewGroup" Name="Icon" Type="string" Value="[INSTALLFOLDER]DesktopCraft.exe" />
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftNewGroup\command" Type="string" Value="&quot;[INSTALLFOLDER]DesktopCraft.exe&quot; --command new-group" />
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftSettings" Name="MUIVerb" Type="string" Value="DesktopCraft settings" />
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftSettings" Name="Icon" Type="string" Value="[INSTALLFOLDER]DesktopCraft.exe" />
            <RegistryValue Root="HKCU" Key="Software\Classes\DesktopBackground\Shell\DesktopCraftSettings\command" Type="string" Value="&quot;[INSTALLFOLDER]DesktopCraft.exe&quot; --command settings" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\DesktopCraftPinFile" Name="MUIVerb" Type="string" Value="Pin to DesktopCraft" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\DesktopCraftPinFile" Name="Icon" Type="string" Value="[INSTALLFOLDER]DesktopCraft.exe" />
            <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\DesktopCraftPinFile\command" Type="string" Value="&quot;[INSTALLFOLDER]DesktopCraft.exe&quot; --pin-file &quot;%1&quot;" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="DesktopCraftStartMenu" Guid="247e4ac4-9f1b-46aa-a763-97d69fa2fd19">
        <Shortcut Id="DesktopCraftStartShortcut" Name="DesktopCraft"
                  Target="[INSTALLFOLDER]DesktopCraft.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DesktopCraft\MSI"
                       Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="DesktopCraftFeature" Title="DesktopCraft" Level="1">
      <ComponentRef Id="DesktopCraftProgram" />
      <ComponentRef Id="DesktopCraftShellMenus" />
      <ComponentRef Id="DesktopCraftStartMenu" />
    </Feature>
  </Package>
</Wix>
